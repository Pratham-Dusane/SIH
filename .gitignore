# ==========================================
# SatQuery AI - Git Ignore Specification
# ==========================================

# ─── Explicit Allow ───
!prd.md
!README.md
!.gitkeep

# ─── Node / Next.js dependencies & builds ───
node_modules/
frontend/node_modules/
.pnp
.pnp.*
.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases

# Next.js build output
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.vercel/

# ─── Python virtual environments & bytecode ───
.venv/
backend/.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# ─── Local databases, data storage & models ───
_data/
_demo_data/
_storage/
*.db
*.sqlite
*.sqlite3
*.geotiff
*.tiff
*.tif
!samples/*.tif
!samples/*.png

# ─── Environment secrets & local config ───
.env
.env.local
.env.*.local
frontend/.env.local
backend/.env
!.env.example
!*.env.example
!**/.env.example

# ─── Logs & debug ───
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── OS & IDE temporary files ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ─── TypeScript build info ───
*.tsbuildinfo
next-env.d.ts

# Phase 4: service-account keys - never commit
_secrets/
backend/_secrets/
*-service-account.json
gee-service-account*.json
