# SatQuery AI Backend Environment Configuration — PRD §15
# Copy to `.env` and fill in the blanks.  `.env` is gitignored; never commit keys.

# --- runtime switches (Design Rule 5) ---
STORAGE_BACKEND=local             # local | gcs
DB_BACKEND=sqlite                 # sqlite | firestore
PLANNER_BACKEND=local             # local | vertex
FUSION_BACKEND=template           # template | vertex
AUTH_DISABLED=true                # true only for local dev and offline evaluation

# Offline evaluation mode (PRD §11.5).  When true, every tool with
# offline_capable=False returns NOT_EVALUATED_OFFLINE instead of calling out.
OFFLINE_MODE=false

# --- local paths ---
LOCAL_STORAGE_ROOT=./_data
SQLITE_PATH=./_data/satquery.db
API_BASE_URL=http://localhost:8080

# --- VLM gateway (PRD §7.1) ---
VLM_BACKEND=vertex               # vertex | gemini | gpt4v | claude
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Concrete model ids per provider.  The PRD's example backend card (§7.6) names
# `gemini-1.5-pro-vision`, which is retired upstream; the live value is whatever
# is set here and it is what /api/models reports.
# gemini-3.6-flash is verified: it returns rs_ground boxes normalised to [0,1].
# gemini-3.5-flash answers on a 0-1000 scale, which parse_bbox rejects (§8.3.3).
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-5
VLM_TIMEOUT_S=90
VLM_MAX_TOKENS=2048
# Gemini 3.x spends output budget on internal reasoning; 'low' halves that cost.
GEMINI_THINKING_LEVEL=low

# --- Vertex AI (default VLM transport) ---
# Same Gemini models, served from your own GCP project and authenticated with the
# SAME service-account JSON as Earth Engine. Billed per token instead of being
# capped at the AI Studio free tier's per-day request limit.
# Leave VERTEX_PROJECT / VERTEX_KEY_PATH blank to reuse GEE_PROJECT / GEE_KEY_PATH.
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash
VERTEX_KEY_PATH=

# --- Google Earth Engine (PRD §7.2) ---
GEE_SERVICE_ACCOUNT=
GEE_KEY_PATH=./_secrets/gee-service-account.json
GEE_PROJECT=

# --- agent tuning ---
ABSTAIN_THRESHOLD=0.35
MAX_PLAN_STEPS=8
DEFAULT_SELF_CONSISTENCY=3
TILE_THRESHOLD_PX=16777216        # 4096*4096
TILE_SIZE=1024
TILE_OVERLAP=128

# --- GCP (Section 17; unused while STORAGE_BACKEND=local) ---
GCP_PROJECT_ID=sih-auth-a5cb4
GCP_REGION=asia-south1
GCS_BUCKET_NAME=satquery-scenes
